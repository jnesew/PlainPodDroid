require "shellwords"

opt_out_usage
ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"
default_platform(:android)
ROOT = File.expand_path("..", __dir__)

def local_command(*arguments)
  Dir.chdir(ROOT) do
    UI.user_error!("Local command failed") unless system(*arguments)
  end
end

def required_option(options, name)
  value = options[name]
  UI.user_error!("Provide #{name}:VALUE") if value.nil? || value.to_s.empty?
  value.to_s
end

def optional_options(arguments, options, flags)
  flags.each do |name, flag|
    arguments.concat([flag, options[name].to_s]) if options[name]
  end
end

platform :android do
  desc "Show automatic local release directories for the clean source checkpoint"
  lane :paths do |options|
    arguments = ["python3", "tools/release_tools.py", "paths"]
    optional_options(arguments, options, {release_root: "--release-root"})
    local_command(*arguments)
  end

  desc "Check local Fastlane/F-Droid listing metadata"
  lane :metadata do
    local_command("python3", "tools/verify-metadata.py")
  end

  desc "Build and verify a clean committed unsigned release candidate"
  lane :prepare do |options|
    arguments = ["bash", "tools/prepare-release.sh"]
    optional_options(arguments, options, {output: "--output", sdk: "--sdk", release_root: "--release-root"})
    arguments << "--offline" if options[:offline].to_s == "true"
    local_command(*arguments)
  end

  desc "Sign an approved candidate interactively with an existing external key"
  lane :sign do |options|
    if options[:input]
      # Retain the existing explicit low-level interface for advanced callers.
      arguments = ["bash", "tools/sign-release-apk.sh", "--input", options[:input].to_s,
                   "--output", required_option(options, :output)]
    else
      arguments = ["bash", "tools/sign-prepared-release.sh"]
      optional_options(arguments, options, {candidate: "--candidate", output: "--output",
                                          release_root: "--release-root"})
    end
    {keystore: "--keystore", alias: "--alias", cert_sha256: "--cert-sha256"}.each do |name, flag|
      arguments += [flag, required_option(options, name)]
    end
    optional_options(arguments, options, {sdk: "--sdk"})
    local_command(*arguments)
  end

  desc "Verify the signed payload and prepare a local release packet"
  lane :package do |options|
    arguments = ["bash", "tools/package-release.sh"]
    arguments += ["--cert-sha256", required_option(options, :cert_sha256)]
    optional_options(arguments, options, {candidate: "--candidate", apk: "--apk", output: "--output",
                                        sdk: "--sdk", release_root: "--release-root"})
    local_command(*arguments)
  end

  desc "Seed a disposable debug emulator for original demonstration screenshots"
  lane :screenshots do |options|
    arguments = ["python3", "tools/screenshot-demo.py", "--serial", required_option(options, :serial)]
    arguments += ["--theme", options[:theme]] if options[:theme]
    arguments << "--offline" if options[:offline].to_s == "true"
    local_command(*arguments)
  end
end

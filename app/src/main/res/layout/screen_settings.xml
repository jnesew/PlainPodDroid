<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen_settings" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_surface" android:padding="16dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:accessibilityHeading="true" android:text="@string/playback_privacy_heading" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
            <Switch android:id="@+id/never_stream_audio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/never_stream_audio" />
            <TextView android:text="@string/never_stream_audio_explanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Switch android:id="@+id/download_before_playing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/download_before_playing" />
            <TextView android:text="@string/download_before_playing_explanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Switch android:id="@+id/auto_delete_completed" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/auto_delete_completed" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/auto_delete_completed_explanation" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/playback_completion_mode" android:text="@string/playback_completion_label" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Spinner android:id="@+id/playback_completion_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:prompt="@string/playback_completion_label" />
            <Button android:id="@+id/playback_setting_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/ui_playback_info" style="@style/Widget.PlainPod.Button" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_surface" android:padding="16dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:accessibilityHeading="true" android:text="@string/download_storage_heading" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/download_storage_quota" android:text="@string/download_storage_quota_label" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Spinner android:id="@+id/download_storage_quota" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:prompt="@string/download_storage_quota_label" />
            <TextView android:id="@+id/download_storage_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:accessibilityLiveRegion="polite" android:text="@string/download_storage_usage_loading" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Switch android:id="@+id/automatic_download_unmetered" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/automatic_download_unmetered" />
        </LinearLayout>
        <include layout="@layout/view_preparation_settings" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_surface" android:padding="16dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:accessibilityHeading="true" android:text="@string/automatic_refresh_heading" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/automatic_refresh_interval" android:text="@string/automatic_refresh_interval_label" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Spinner android:id="@+id/automatic_refresh_interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:prompt="@string/automatic_refresh_interval_label" />
            <Switch android:id="@+id/automatic_refresh_unmetered" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/automatic_refresh_unmetered" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_surface" android:padding="16dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:accessibilityHeading="true" android:text="@string/playback_skip_settings_heading" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/playback_skip_back_interval" android:text="@string/playback_skip_back_label" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Spinner android:id="@+id/playback_skip_back_interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:prompt="@string/playback_skip_back_label" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:labelFor="@id/playback_skip_forward_interval" android:text="@string/playback_skip_forward_label" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Spinner android:id="@+id/playback_skip_forward_interval" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:prompt="@string/playback_skip_forward_label" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_surface" android:padding="16dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_import_export" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" android:accessibilityHeading="true" />
            <Button android:layout_marginTop="12dp" android:id="@+id/settings_import_opml" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/opml_heading" style="@style/Widget.PlainPod.Button" />
            <Button android:layout_marginTop="12dp" android:id="@+id/export_opml" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/export_opml" style="@style/Widget.PlainPod.Button" />
            <TextView android:id="@+id/opml_export_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="15sp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_surface" android:padding="16dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:labelFor="@id/display_theme" android:text="@string/display_theme_label" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Spinner android:id="@+id/display_theme" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:prompt="@string/display_theme_label" />
            <TextView android:id="@+id/version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Button android:id="@+id/open_about" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:minHeight="48dp" android:text="@string/about_open" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/playback_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:labelFor="@id/playback_speed" android:text="@string/playback_speed_label" android:textColor="@color/text_secondary" android:textSize="15sp" />
    <Spinner android:id="@+id/playback_speed" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:prompt="@string/playback_speed_label" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/playback_sleep_timer_option" android:text="@string/playback_sleep_timer_label" android:textColor="@color/text_secondary" android:textSize="15sp" />
    <Spinner android:id="@+id/playback_sleep_timer_option" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:minHeight="48dp" android:prompt="@string/playback_sleep_timer_label" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <Button android:id="@+id/playback_sleep_timer_set" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:enabled="false" android:minHeight="48dp" android:text="@string/playback_sleep_timer_set_action" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
        <Button android:id="@+id/playback_sleep_timer_cancel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:enabled="false" android:minHeight="48dp" android:text="@string/playback_sleep_timer_cancel_action" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
    </LinearLayout>
    <TextView android:id="@+id/playback_sleep_timer_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:accessibilityLiveRegion="polite" android:text="@string/playback_sleep_timer_unavailable" android:textColor="@color/text_secondary" android:textSize="15sp" />
    <Button android:id="@+id/playback_stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:minHeight="48dp" android:text="@string/playback_stop_action" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
</LinearLayout>
<?xml version='1.0' encoding='utf-8'?>
<io.github.jnesew.plainpoddroid.ui.PullRefreshScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen_podcasts" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <ProgressBar android:id="@+id/refresh_all_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:indeterminate="true" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/refresh_all_status" android:background="?android:attr/selectableItemBackground" android:paddingTop="12dp" android:paddingBottom="12dp" android:minHeight="48dp" android:focusable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:textColor="@color/text_secondary" android:visibility="gone" android:textSize="15sp" />
        <LinearLayout android:id="@+id/podcast_search_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:visibility="gone">
                <EditText android:id="@+id/catalog_podcast_search" android:hint="@string/catalog_podcast_search_hint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:importantForAutofill="no" android:inputType="text" android:maxLength="128" android:maxLines="1" android:singleLine="true" android:imeOptions="actionSearch" android:minHeight="48dp" android:layout_weight="1" />
        </LinearLayout>
        <ProgressBar android:id="@+id/catalog_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:indeterminate="true" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/catalog_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:text="@string/catalog_status_idle" android:textColor="@color/text_secondary" android:textSize="15sp" />
        <LinearLayout android:id="@+id/podcast_library_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <Button android:id="@+id/add_podcast_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_add_podcast" android:minHeight="48dp" style="@style/Widget.PlainPod.Button" android:drawableStart="@drawable/ic_add" />
        <LinearLayout android:id="@+id/podcast_library_commands" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <Button android:id="@+id/refresh_catalog" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/catalog_refresh_action" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
            <Button android:id="@+id/refresh_all_subscriptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/refresh_all_action" android:visibility="gone" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
            <Button android:id="@+id/cancel_refresh_all" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/refresh_all_cancel_action" android:visibility="gone" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</io.github.jnesew.plainpoddroid.ui.PullRefreshScrollView>
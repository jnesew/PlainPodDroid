<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen_queue" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <ProgressBar android:id="@+id/episode_queue_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/episode_queue_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:text="@string/episode_queue_status_idle" android:textColor="@color/text_secondary" android:textSize="15sp" />
        <LinearLayout android:id="@+id/episode_queue_entries" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/queue_page_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="14sp" android:gravity="center" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/previous_queue_page" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:minHeight="48dp" android:text="@string/episode_queue_previous_page_action" android:visibility="gone" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
            <Button android:id="@+id/next_queue_page" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:minHeight="48dp" android:text="@string/episode_queue_next_page_action" android:visibility="gone" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <Button android:id="@+id/refresh_episode_queue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/episode_queue_refresh_action" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen_episode" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <ProgressBar android:id="@+id/episode_action_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/episode_action_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:text="@string/episode_details_status_idle" android:textColor="@color/text_secondary" android:textSize="15sp" />
        <TextView android:id="@+id/playback_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:accessibilityLiveRegion="polite" android:text="@string/playback_status_unavailable" android:textColor="@color/text_secondary" android:textSize="15sp" android:visibility="gone" />
        <LinearLayout android:id="@+id/episode_details_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <ImageView android:id="@+id/episode_cover" android:layout_width="264dp" android:layout_height="264dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:layout_marginBottom="20dp" android:src="@drawable/ic_podcast" android:background="@drawable/artwork_surface" android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <TextView android:id="@+id/episode_details_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="26sp" android:gravity="center" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:textStyle="bold" />
            <TextView android:id="@+id/episode_details_author" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="18sp" android:gravity="center" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/episode_details_metadata" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="14sp" android:gravity="center" android:layout_marginBottom="4dp" android:maxLines="3" android:ellipsize="end" />
            <io.github.jnesew.plainpoddroid.ui.ChapterSeekBar android:id="@+id/episode_seek" android:layout_width="match_parent" android:layout_height="48dp" android:max="1000" android:contentDescription="@string/ui_seek" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/episode_position" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="15sp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:layout_weight="1" android:gravity="start" />
                <TextView android:id="@+id/episode_duration" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="15sp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:layout_weight="1" android:gravity="end" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/episode_playback_controls" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false" android:layout_marginTop="8dp" android:layout_marginBottom="20dp">
                <Button android:id="@+id/playback_skip_back" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginEnd="12dp" android:layout_weight="0" android:enabled="false" android:minHeight="48dp" android:text="@string/playback_skip_back_default" style="@style/Widget.PlainPod.Icon" android:textAllCaps="false" android:layout_marginStart="12dp" />
                <Button android:id="@+id/episode_playback_action" android:layout_width="80dp" android:layout_height="80dp" android:enabled="false" android:minHeight="48dp" android:text="@string/episode_playback_action" style="@style/Widget.PlainPod.Icon" android:textAllCaps="false" android:layout_weight="0" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" />
                <Button android:id="@+id/playback_skip_forward" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="12dp" android:layout_weight="0" android:enabled="false" android:minHeight="48dp" android:text="@string/playback_skip_forward_default" style="@style/Widget.PlainPod.Icon" android:textAllCaps="false" android:layout_marginEnd="12dp" />
            </LinearLayout>
            <Button android:id="@+id/episode_current_chapter" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:maxLines="1" android:ellipsize="end" android:gravity="start|center_vertical" android:text="@string/ui_chapters" android:textSize="15sp" android:visibility="gone" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="22sp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:text="@string/ui_about_episode" android:textStyle="bold" />
            <TextView android:id="@+id/episode_details_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Button android:id="@+id/load_episode_chapters" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/chapter_load_action" android:contentDescription="@string/chapter_load_description" android:visibility="gone" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
            <TextView android:id="@+id/episode_chapter_privacy_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chapter_load_description" android:textSize="15sp" android:visibility="gone" android:textColor="@color/text_secondary" />
            <ProgressBar android:id="@+id/episode_chapter_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
            <TextView android:id="@+id/episode_chapter_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:visibility="gone" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <LinearLayout android:id="@+id/episode_extra_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <Button android:id="@+id/episode_played_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:minHeight="48dp" android:text="@string/episode_mark_played_action" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
                <Button android:id="@+id/open_episode_page" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/episode_details_page_action" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
                <Button android:id="@+id/close_episode_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/episode_details_close_action" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card_surface"
    android:padding="16dp" android:layout_marginBottom="16dp">
    <Switch android:id="@+id/preparation_enabled" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/preparation_heading" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/preparation_explanation"
        android:textColor="@color/text_secondary" android:textSize="15sp" />
    <Button android:id="@+id/preparation_time" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/preparation_time" style="@style/Widget.PlainPod.Button" />
    <Button android:id="@+id/preparation_days" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/preparation_days" style="@style/Widget.PlainPod.Button" />
    <Switch android:id="@+id/preparation_unmetered" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp"
        android:text="@string/preparation_unmetered" />
    <Switch android:id="@+id/preparation_charging" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/preparation_charging" />
    <TextView android:id="@+id/preparation_next" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/preparation_off" android:textColor="@color/text_secondary" android:textSize="15sp" />
    <TextView android:id="@+id/preparation_last" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite"
        android:text="@string/preparation_never" android:textColor="@color/text_secondary" android:textSize="15sp" />
</LinearLayout>

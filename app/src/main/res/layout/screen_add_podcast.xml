<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/screen_add_podcast" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/subscription_url" android:text="@string/subscription_url_label" android:textColor="@color/text_secondary" android:textSize="15sp" />
        <!-- The label names the field; the hint is an example URL, not a second label. -->
        <EditText tools:ignore="LabelFor" android:id="@+id/subscription_url" android:hint="@string/ui_feed_address_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:imeOptions="actionGo" android:importantForAutofill="no" android:inputType="textUri|textNoSuggestions" android:maxLines="3" android:minHeight="48dp" android:saveEnabled="false" />
        <FrameLayout android:id="@+id/subscription_login_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/cancel_subscription_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:minHeight="48dp" android:text="@string/subscription_cancel_action" android:visibility="gone" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
            <Button android:id="@+id/preview_feed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/subscription_preview_action" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
        </LinearLayout>
        <ProgressBar android:id="@+id/subscription_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/subscription_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:visibility="gone" android:textColor="@color/text_secondary" android:textSize="15sp" />
        <LinearLayout android:id="@+id/subscription_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <ImageView android:id="@+id/subscription_preview_artwork" android:layout_width="96dp" android:layout_height="96dp" android:layout_marginBottom="8dp" android:contentDescription="@string/subscription_preview_artwork_description" android:scaleType="fitCenter" android:visibility="gone" />
            <TextView android:id="@+id/subscription_preview_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/subscription_preview_author" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <TextView android:id="@+id/subscription_preview_apple_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_secondary" android:textSize="15sp" android:visibility="gone" />
            <TextView android:id="@+id/subscription_preview_original_origin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <TextView android:id="@+id/subscription_preview_final_origin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <TextView android:id="@+id/subscription_preview_redirects" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:visibility="gone" android:textSize="15sp" />
            <TextView android:id="@+id/subscription_preview_counts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Button android:id="@+id/subscription_preview_feed_address" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/subscription_feed_address" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/subscription_publisher_notice" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Button android:id="@+id/confirm_subscription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/subscription_confirm_action" android:visibility="gone" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:accessibilityHeading="true" android:text="@string/opml_heading" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/opml_instructions" android:textColor="@color/text_secondary" android:textSize="15sp" />
        <Button android:id="@+id/import_opml" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/import_opml" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
        <TextView android:id="@+id/opml_refresh_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="8dp" android:text="@string/ui_opml_refresh_notice" android:visibility="gone" />
        <Button android:id="@+id/opml_details" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_import_details" android:visibility="gone" style="@style/Widget.PlainPod.Button" />
        <Button android:id="@+id/confirm_opml" android:visibility="gone" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:minHeight="48dp" android:text="@string/confirm_opml" style="@style/Widget.PlainPod.Button" android:textAllCaps="false" />
        <TextView android:id="@+id/opml_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:visibility="gone" android:textColor="@color/text_secondary" android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
